{% if site.analytics.gsc %}<meta name="google-site-verification" content="{{ site.analytics.gsc }}">{% endif %}
{% if site.analytics.ga4 %}<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.analytics.ga4 }}"></script>
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','{{ site.analytics.ga4 }}');</script>{% endif %}
